{
  "name": "vmemo-assets",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm ci",
    "build": "npm run build:css",
    "deploy": "npm run deploy:css",
    "build:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/app.css",
    "deploy:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/app.css --minify",
    "watch:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/app.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.0",
    "choices.js": "11.2.3",
    "daisyui": "5.5.23",
    "heroicons": "2.2.0",
    "tailwindcss": "4.3.0"
  }
}
